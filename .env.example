# ==========================================
# NigerSwap Environment Configuration
# ==========================================

# 1. Server Configuration
PORT=10000
NODE_ENV=production
APP_BASE_URL=https://naijaswap.web.app
ENABLE_TESTING_MODE=false

# 2. Paystack Gateway (Live / Production)
# Get from: Paystack Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# 3. Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=naijaswap1
# Minified single-line JSON string of your Firebase service account key
# Get from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"naijaswap1","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}'

# 4. Cloudinary Storage Configuration
# Get from: Cloudinary Dashboard -> Programmable Media -> API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. Brevo (Sendinblue) Transactional Emails
# Get from: Brevo Dashboard -> Top-right profile -> SMTP & API -> API Keys
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@naijaswap.ng
BREVO_SENDER_NAME="NigerSwap"

# 6. Brevo SMTP (Alternative / Nodemailer Relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email@example.com
SMTP_PASS=your_brevo_smtp_key_here
EMAIL_FROM="NigerSwap <noreply@naijaswap.ng>"
