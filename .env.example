# ==========================================
# NigerSwap Environment Configuration
# ==========================================

# 1. Brevo (Sendinblue) API Integration
# Get your API key: Brevo Dashboard -> Top-right profile -> SMTP & API -> API Keys -> Generate key
BREVO_API_KEY=your_brevo_api_key_here

# Brevo Sender Identity
BREVO_SENDER_EMAIL=noreply@naijaswap.ng
BREVO_SENDER_NAME=NigerSwap

# 2. Brevo SMTP (Alternative / Nodemailer Relay)
# Get from: Brevo Dashboard -> Top-right profile -> SMTP & API -> SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email@example.com
SMTP_PASS=your_brevo_smtp_key_here
EMAIL_FROM="NigerSwap <noreply@naijaswap.ng>"

# 3. Application Base URLs
APP_BASE_URL=https://naijaswap.web.app
PORT=10000
